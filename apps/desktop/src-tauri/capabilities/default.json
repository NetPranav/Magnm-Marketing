{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Magnm Studio local pages and engine webview",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "notification:default",
    "updater:default",
    "allow-list-secrets",
    "allow-set-secret",
    "allow-delete-secret",
    "allow-store-secrets",
    "allow-restart-engine",
    "allow-get-engine-logs",
    "allow-update-status",
    "allow-check-update",
    "allow-install-update",
    "allow-restart-app"
  ]
}
