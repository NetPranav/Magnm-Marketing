# Operating system & cloud drive artifacts
.DS_Store
.tmp.drivedownload/
.tmp.driveupload/

# Secrets & environment
.env
.env.*
!.env.example

# Python caches & virtualenvs
__pycache__/
*.pyc
.venv/
.venv-build/

# Tauri packaged sidecar binaries
apps/desktop/src-tauri/binaries/

# Node dependencies & web build output
node_modules/
.pnpm-store/
apps/web/dist/
apps/mobile/dist/
apps/mobile/public/pitch/

# Runtime logs, locks & temp files
logs/jobs/
state/.runtime_job.lock
*.tmp

# Temporary / scratch directory
_to_delete/

# Local engine database and caches (per machine)
state/magnm.db
state/magnm.db-*
state/model_catalog.json

# Team sign-in and sync state (secrets and per-device data; never commit)
state/team_session.json
state/team_session_*.tmp
state/device_id
state/engine_endpoint.json
cache/previews/
state/knowledge_backups/

# The data folder can be this (public) repo: never commit what the app writes there.
/state/*
/assets/uploads/
/assets/results/
/cache/
/workspaces/
/queue/
/outputs/pitch/
/outputs/**/browser-shots/
/outputs/content/

# Per-user repositories and what was generated from them: the software ships with none.
/config/repos.json
/research/repo-sync.json
/research/repo-sync.md

# Files made by scripts/release.py (installers, signatures, latest.json); never commit them.
/dist-release/
