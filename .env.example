# ==============================================================================
# MAGNM PR & SOCIAL MEDIA MARKETING TEAM — AI MODEL & API CONFIGURATION TEMPLATE
# Copy this file to .env (`cp .env.example .env`) and insert your API keys.
# ==============================================================================

# Active Inference Strategy: nvidia_nim | auto | openai | anthropic | gemini | ollama
AI_DEFAULT_PROVIDER=nvidia_nim
AI_USE_CHATGPT_CLI_FALLBACK=false

# ------------------------------------------------------------------------------
# PRIMARY PROVIDER: NVIDIA NIM (OpenAI-Compatible API)
# ------------------------------------------------------------------------------
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
# Or set NVIDIA_NIM_API_KEY1..N (up to NVIDIA_NIM_API_KEY20) -- one per NVIDIA account, used in rotation:
# NVIDIA_NIM_API_KEY1=
# NVIDIA_NIM_API_KEY2=

# Optional Per-Role NVIDIA NIM API Keys (if blank, uses NVIDIA_NIM_API_KEY)
NVIDIA_NIM_API_KEY_CMO=
NVIDIA_NIM_API_KEY_STRATEGIST=
NVIDIA_NIM_API_KEY_ADVISOR=
NVIDIA_NIM_API_KEY_RESEARCHER=
NVIDIA_NIM_API_KEY_BLOG_WRITER=
NVIDIA_NIM_API_KEY_WRITER=
NVIDIA_NIM_API_KEY_DESIGNER=
NVIDIA_NIM_API_KEY_VIDEO_PRODUCER=
NVIDIA_NIM_API_KEY_REVIEWER=
NVIDIA_NIM_API_KEY_ANALYST=
NVIDIA_NIM_API_KEY_LISTENER=
NVIDIA_NIM_API_KEY_COMMUNITY=
NVIDIA_NIM_API_KEY_GROWTH=

# ------------------------------------------------------------------------------
# PER-ROLE NVIDIA NIM MODEL ROUTING (13 SPECIALIST ROLES)
# ------------------------------------------------------------------------------
# Models now live in config/models.json (tiers and per-role tier assignments).
# NIM_MODEL_<ROLE> (e.g. NIM_MODEL_CMO=...) still works as an optional override,
# but is ignored with a warning if NVIDIA's model catalog does not have that model.

# ------------------------------------------------------------------------------
# OPTIONAL SECONDARY PROVIDERS
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Optional GitHub Fine-Grained Personal Access Token (read-only Contents & Pull requests)
GITHUB_TOKEN=
